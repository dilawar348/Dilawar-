<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday My Love!</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: radial-gradient(circle at center, #1e112a 0%, #08030d 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Poppins', sans-serif;
            color: white;
            overflow: hidden;
        }

        .main-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 30px;
            z-index: 5;
        }

        .instruction {
            font-size: 1rem;
            color: #ffb3d9;
            letter-spacing: 1px;
            animation: pulse 2s infinite ease-in-out;
            text-align: center;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.7; transform: scale(0.98); }
            50% { opacity: 1; transform: scale(1.02); }
        }

        /* CAKE & CANDLE CONTAINER */
        .cake-container {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-top: 60px;
        }

        /* 3D CANDLE */
        .candle {
            position: relative;
            width: 16px;
            height: 70px;
            background: linear-gradient(to right, #ff758c, #ff7eb3, #e85d75);
            border-radius: 6px 6px 3px 3px;
            cursor: pointer;
            z-index: 10;
            box-shadow: inset -2px 0 5px rgba(0,0,0,0.2);
        }

        .candle::before {
            content: '';
            position: absolute;
            top: -3px;
            width: 100%;
            height: 6px;
            background: #ffaec9;
            border-radius: 50%;
        }

        .wick {
            position: absolute;
            top: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 3px;
            height: 9px;
            background-color: #222;
        }

        .flame {
            position: absolute;
            top: -32px;
            left: 50%;
            transform: translateX(-50%);
            width: 16px;
            height: 26px;
            background: radial-gradient(ellipse at bottom, #ffffff 0%, #ffe600 25%, #ff5722 70%, rgba(255, 87, 34, 0) 100%);
            border-radius: 50% 50% 35% 35% / 60% 60% 40% 40%;
            box-shadow: 0 0 15px #ff9800, 0 0 30px #ff5722;
            animation: flicker 0.12s infinite alternate ease-in-out;
        }

        @keyframes flicker {
            0% { transform: translateX(-50%) scale(1); }
            100% { transform: translateX(-50%) scale(1.1); }
        }

        .smoke {
            position: absolute;
            top: -25px;
            left: 50%;
            transform: translateX(-50%);
            width: 8px;
            height: 20px;
            background: rgba(200, 200, 200, 0.5);
            border-radius: 50%;
            filter: blur(4px);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        /* 3D KNIFE */
        .knife {
            position: absolute;
            right: -80px;
            top: 20px;
            display: none;
            flex-direction: column;
            align-items: center;
            cursor: pointer;
            z-index: 20;
            transform: rotate(45deg);
            transition: transform 0.5s ease;
        }

        .blade {
            width: 12px;
            height: 70px;
            background: linear-gradient(to right, #e0e0e0, #ffffff, #999);
            border-radius: 0 100% 5px 5px;
            box-shadow: 0 0 8px rgba(255,255,255,0.5);
        }

        .handle {
            width: 14px;
            height: 40px;
            background: #4a2c11;
            border-radius: 3px;
        }

        .knife.slicing {
            animation: sliceCake 1s forwards ease-in-out;
        }

        @keyframes sliceCake {
            0% { transform: rotate(45deg) translate(0, 0); }
            50% { transform: rotate(0deg) translate(-100px, 40px); }
            100% { transform: rotate(0deg) translate(-100px, 120px); opacity: 0; }
        }

        /* 3D CAKE */
        .cake {
            position: relative;
            width: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .cut-line {
            position: absolute;
            top: 0;
            width: 3px;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 15;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .layer {
            width: 100%;
            border-radius: 12px;
            position: relative;
        }

        .layer-top {
            height: 45px;
            width: 140px;
            background: linear-gradient(to right, #f8a5c2, #f78fb3);
            z-index: 3;
        }

        .icing-drip {
            position: absolute;
            top: 0;
            width: 100%;
            height: 15px;
            background: #fff;
            border-radius: 10px 10px 8px 8px;
        }

        .cherry {
            position: absolute;
            top: -8px;
            width: 12px;
            height: 12px;
            background: #e74c3c;
            border-radius: 50%;
        }
        .cherry-1 { left: 20px; }
        .cherry-2 { left: 64px; }
        .cherry-3 { right: 20px; }

        .layer-middle {
            height: 50px;
            width: 170px;
            background: linear-gradient(to right, #63c2de, #5b9bd5);
            margin-top: -5px;
            z-index: 2;
        }

        .layer-bottom {
            height: 55px;
            width: 200px;
            background: linear-gradient(to right, #f3a683, #e17055);
            margin-top: -5px;
            z-index: 1;
        }

        .plate {
            width: 240px;
            height: 14px;
            background: #e0e0e0;
            border-radius: 10px;
            margin-top: -4px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        }

        /* BALLOONS ANIMATION */
        #balloon-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 1;
            overflow: hidden;
        }

        .balloon {
            position: absolute;
            bottom: -100px;
            width: 40px;
            height: 50px;
            border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;
            animation: floatUp linear forwards;
        }

        .balloon::after {
            content: "";
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 15px;
            background: rgba(255, 255, 255, 0.6);
        }

        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-120vh) rotate(20deg); opacity: 0; }
        }

        /* CARD MODAL POPUP */
        .card-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(8px);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.5s ease;
        }

        .card-modal.active {
            opacity: 1;
            pointer-events: auto;
        }

        .card-content {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.05));
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            border-radius: 20px;
            padding: 35px 25px;
            width: 90%;
            max-width: 420px;
            text-align: center;
            transform: scale(0.8);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .card-modal.active .card-content {
            transform: scale(1);
        }

        .heart-icon {
            font-size: 2.5rem;
            animation: heartBeat 1.2s infinite ease-in-out;
            margin-bottom: 10px;
        }

        @keyframes heartBeat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }

        .card-content h2 {
            color: #ff758c;
            font-size: 1.5rem;
            margin-bottom: 15px;
            letter-spacing: 0.5px;
            text-shadow: 0 0 10px rgba(255, 117, 140, 0.5);
        }

        .card-content .note {
            color: #f1f1f1;
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .close-btn {
            background: linear-gradient(45deg, #ff4d6d, #ff758c);
            color: white;
            border: none;
            padding: 10px 22px;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(255, 77, 109, 0.4);
            transition: all 0.3s ease;
        }

        .close-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 77, 109, 0.6);
        }
    </style>
</head>
<body>

    <!-- Balloon Container -->
    <div id="balloon-container"></div>

    <div class="main-container">
        <!-- 3D Cake & Candle Section -->
        <div class="cake-container">
            
            <!-- Candle (Clickable) -->
            <div class="candle" id="candle" onclick="blowCandle()">
                <div class="wick"></div>
                <div class="flame" id="flame"></div>
                <div class="smoke" id="smoke"></div>
            </div>

            <!-- Interactive Knife -->
            <div class="knife" id="knife" onclick="cutCake()" title="Click to cut the cake!">
                <div class="blade"></div>
                <div class="handle"></div>
            </div>

            <!-- 3D Layered Cake -->
            <div class="cake" id="cake">
                <div class="cut-line" id="cut-line"></div>
                <div class="layer layer-top">
                    <div class="icing-drip"></div>
                    <div class="cherry cherry-1"></div>
                    <div class="cherry cherry-2"></div>
                    <div class="cherry cherry-3"></div>
                </div>
                <div class="layer layer-middle"></div>
                <div class="layer layer-bottom"></div>
                <div class="plate"></div>
            </div>

        </div>

        <p class="instruction" id="instruction-text">✨ Candle par click karke isay bujhao! ✨</p>
    </div>

    <!-- Birthday Wishes Card Modal -->
    <div class="card-modal" id="card-modal">
        <div class="card-content">
            <div class="heart-icon">❤️</div>
            <h2>Happy birthday dear wifey ❤️</h2>
            <p class="note">
                Allah ap ka ya din bohttttt khose hal banay or Allah ap ko bohttttt sari khosea dayn kamyabi dayn sahat wali lambi Zindagi dayn or Allah ap ko hamasha khose rakhyn Ameeeeeeeeeeeeeen 🤲✨
            </p>
            <button class="close-btn" onclick="closeCard()">Close Card 💖</button>
        </div>
    </div>

    <!-- Audio Elements -->
    <audio id="applause-sound" src="https://assets.mixkit.co/active_storage/sfx/2012/2012-preview.mp3" preload="auto"></audio>
    <audio id="bday-song" src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_c8c8a73503.mp3" loop></audio>

    <script>
        let isBlown = false;
        let isCut = false;

        function blowCandle() {
            if (isBlown) return;

            const flame = document.getElementById('flame');
            const smoke = document.getElementById('smoke');
            const instruction = document.getElementById('instruction-text');
            const knife = document.getElementById('knife');
            const applause = document.getElementById('applause-sound');
            const song = document.getElementById('bday-song');

            flame.style.display = "none";
            smoke.style.opacity = "1";
            isBlown = true;

            setTimeout(() => { smoke.style.opacity = "0"; }, 1500);

            knife.style.display = "flex";
            instruction.innerText = "🔪 Ab Knife par click karke Cake cut karo! 🎂";

            applause.volume = 0.8;
            applause.play();

            setTimeout(() => {
                song.volume = 0.6;
                song.play();
            }, 1000);
        }

        function cutCake() {
            if (!isBlown || isCut) return;

            const knife = document.getElementById('knife');
            const cutLine = document.getElementById('cut-line');
            const instruction = document.getElementById('instruction-text');
            const applause = document.getElementById('applause-sound');
            const cardModal = document.getElementById('card-modal');

            knife.classList.add('slicing');

            setTimeout(() => {
                cutLine.style.opacity = "1";
                instruction.innerText = "🎉 Yayy! Happy Birthday! 🎉";
                
                applause.currentTime = 0;
                applause.play();

                createBalloons();
                isCut = true;

                setTimeout(() => {
                    cardModal.classList.add('active');
                }, 1200);

            }, 700);
        }

        function closeCard() {
            document.getElementById('card-modal').classList.remove('active');
        }

        function createBalloons() {
            const container = document.getElementById('balloon-container');
            const colors = ['#ff4d6d', '#ffb703', '#06d6a0', '#118ab2', '#7209b7', '#ff007f'];

            for (let i = 0; i < 35; i++) {
                const balloon = document.createElement('div');
                balloon.className = 'balloon';
                balloon.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                balloon.style.left = Math.random() * 100 + 'vw';
                balloon.style.animationDuration = (Math.random() * 3 + 4) + 's';
                balloon.style.animationDelay = (Math.random() * 2) + 's';
                container.appendChild(balloon);
            }
        }
    </script>
</body>
</html>
